{
    "name": "jundayw/proxy",
    "version": "0.1.0",
    "description": "A lightweight, type-safe, inheritance-based extension package for dynamic proxies and AOP(aspect-oriented programming).",
    "keywords": [
        "proxy",
        "service proxies",
        "interceptor",
        "hook",
        "aop",
        "annotation",
        "proxy"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/jundayw/proxy",
    "authors": [
        {
            "name": "Mr.Moore",
            "email": "jundayw@126.com"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-code": "^4.17"
    },
    "require-dev": {
        "code-lts/doctum": "^5.0",
        "jundayw/composer-version-plugin": "^1.0"
    },
    "autoload": {
        "files": [
            "src/helper.php"
        ],
        "psr-0": {
            "Proxy\\": "PSR-0/"
        },
        "psr-4": {
            "Jundayw\\Proxy\\": "src/",
            "Proxy\\": "PSR-4/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs": "@php vendor/bin/doctum.php update doctum.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "jundayw/composer-version-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
