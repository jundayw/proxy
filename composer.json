{
    "name": "jundayw/proxy",
    "description": "This library aims to provide abstraction for generating various kinds of proxy classes.",
    "keywords": [
        "proxy",
        "service proxies",
        "interceptor",
        "hook",
        "aop",
        "annotation",
        "proxy"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/jundayw/proxy",
    "authors": [
        {
            "name": "Mr.Moore",
            "email": "jundayw@126.com"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "annotation/larscan": "^1.1",
        "laminas/laminas-code": "^4.17"
    },
    "require-dev": {
        "code-lts/doctum": "^5.0",
        "jundayw/composer-version-plugin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Jundayw\\Proxy\\": "src/",
            "Proxy\\": "proxy/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs": "@php vendor/bin/doctum.php update doctum.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Jundayw\\Proxy\\ProxyServiceProvider"
            ],
            "aliases": {
                "Token": "Jundayw\\Proxy\\Facades\\Proxy"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "jundayw/composer-version-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
